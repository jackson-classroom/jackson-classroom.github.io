const MC = [
 {q:"In the photoelectron spectrum of magnesium, which peak appears at the highest binding energy?",
  c:["The 3s peak, because those electrons are in the outermost shell",
     "The 1s peak, because those electrons are closest to the nucleus and least shielded",
     "The 2p peak, because it is the tallest peak in the spectrum",
     "All peaks appear at the same binding energy because they belong to the same atom"],
  a:1,
  e:"Binding energy is set by how tightly the nucleus holds an electron. The 1s electrons are closest to the nucleus and have almost nothing shielding them, so they feel the largest effective nuclear charge and require the most energy to remove. <b>Peak height never tells you about energy</b> &mdash; only about how many electrons are in that subshell."},

 {q:"A spectrum of a neutral atom shows five peaks with relative heights, from highest binding energy to lowest, of 2, 2, 6, 2, 3. Which element is it?",
  c:["Aluminum","Silicon","Phosphorus","Chlorine"],
  a:2,
  e:"Five peaks means five occupied subshells, which in filling order are 1s, 2s, 2p, 3s, 3p. The heights give 1s&sup2;2s&sup2;2p&#8310;3s&sup2;3p&sup3;. Adding them: 2+2+6+2+3 = 15 electrons, and a neutral atom with 15 electrons has 15 protons &mdash; <b>phosphorus</b>."},

 {q:"The 1s binding energy of neon (84.0 MJ/mol) is higher than that of fluorine (67.4 MJ/mol). The best explanation is that neon&hellip;",
  c:["has more electrons, so its electrons repel each other more strongly",
     "has one more proton, and its 1s electrons are shielded no better than fluorine's, so they feel a greater effective nuclear charge",
     "has a completely full 2p subshell, which stabilizes the 1s electrons",
     "has a larger atomic radius, placing the 1s electrons farther from the nucleus"],
  a:1,
  e:"Both atoms shield their 1s electrons about equally &mdash; there is essentially nothing between a 1s electron and the nucleus. Neon simply has an extra proton, so Z<sub>eff</sub> at the 1s level goes up, Coulombic attraction goes up, and the binding energy goes up. This is why every column in the data table increases as you move down."},

 {q:"How many peaks appear in the photoelectron spectrum of a ground-state calcium atom?",
  c:["Four","Five","Six","Twenty"],
  a:2,
  e:"Calcium is 1s&sup2;2s&sup2;2p&#8310;3s&sup2;3p&#8310;4s&sup2; &mdash; six occupied subshells, so <b>six peaks</b>. The classic error is answering four by counting shells (n = 1, 2, 3, 4). PES resolves subshells, not shells, and that is exactly the evidence that broke the simple Bohr picture."},

 {q:"In the spectrum of argon, the 2p peak is three times as tall as the 3s peak. Why?",
  c:["The 2p electrons are held three times as tightly as the 3s electrons",
     "The 2p subshell contains six electrons while the 3s subshell contains two",
     "Photons of higher energy eject electrons more efficiently",
     "The 2p subshell has three orbitals and the 3s subshell has one"],
  a:1,
  e:"Peak height is proportional to the <b>number of electrons</b> in the subshell: 2p&#8310; against 3s&sup2; is a 6:2 = 3:1 ratio. Choice D gets the right ratio for the wrong reason &mdash; the signal tracks electrons, not orbitals, which is why a 2p&sup1; peak is short even though 2p still has three orbitals."},

 {q:"Which claim about atomic structure is contradicted by photoelectron spectroscopy data?",
  c:["Electrons occupy discrete energy levels",
     "Core electrons are held more tightly than valence electrons",
     "All electrons in the n = 2 shell have the same energy",
     "Effective nuclear charge increases across a period"],
  a:2,
  e:"Every second-period element from boron onward shows <b>two separate peaks</b> for n = 2 &mdash; one for 2s and one for 2p, at clearly different binding energies. That splitting is direct experimental evidence for subshells and against a model in which a shell is a single energy level."},

 {q:"A spectrum shows three peaks with heights 2, 2, 6, and the sample is known to be a singly charged cation. What is it?",
  c:["Ne&#8314;","Na&#8314;","F&#8315;","Mg&sup2;&#8314;"],
  a:1,
  e:"The heights total 10 electrons. But a 1+ cation has one <em>more</em> proton than it has electrons, so Z = 11: this is <b>Na&#8314;</b>. Ion questions are the one place where 'add the heights to get the element' fails &mdash; the heights always give you the electron count, and you adjust for charge to get Z."},

 {q:"The 3p binding energy of sulfur (1.00 MJ/mol) is slightly lower than that of phosphorus (1.06 MJ/mol), even though sulfur has one more proton. The best explanation is that in sulfur&hellip;",
  c:["the extra 3p electron must pair up in an already-occupied orbital, and the added electron&ndash;electron repulsion outweighs the extra nuclear charge",
     "the 3p subshell is farther from the nucleus than it is in phosphorus",
     "the extra proton is shielded by the 1s electrons",
     "the measurement is within experimental error and the difference is not real"],
  a:0,
  e:"Phosphorus has 3p&sup3;, one electron alone in each p orbital. Sulfur's fourth 3p electron has to double up, and two electrons crowded in the same orbital repel each other significantly. That repulsion raises the energy of the electron &mdash; making it easier to remove &mdash; by more than the extra proton tightens it. The same effect shows up as the well-known dip in first ionization energy from P to S."}
];

const FRQ = [
 {q:"Using Coulomb's law, explain why the 1s electrons of a carbon atom have a binding energy of 28.6 MJ/mol while its 2p electrons require only 1.09 MJ/mol.",
  m:"<p>The 1s electrons are in the n = 1 shell, much closer to the nucleus than the 2p electrons in n = 2. Coulombic attraction is inversely proportional to the square of the distance, so decreasing r sharply increases the force holding the electron.</p><p>In addition, the 1s electrons are shielded by essentially nothing, so they experience an effective nuclear charge close to the full +6. The 2p electrons are shielded by the 1s and 2s electrons, so they feel a much smaller Z<sub>eff</sub>.</p><p>Being both closer and less shielded, the 1s electrons are held far more strongly, and it takes about 26 times as much energy per mole to remove one.</p><p class='note'><b>Scoring watch-outs:</b> naming Coulomb's law without connecting it to <em>both</em> distance and effective nuclear charge usually loses a point. Saying the 1s electrons have 'lower energy' is fine, but you still have to say why.</p>"},

 {q:"Describe how the photoelectron spectrum of oxygen differs from that of nitrogen, and account for each difference.",
  m:"<p>Both spectra have three peaks, because both elements occupy the same three subshells: 1s, 2s, and 2p.</p><p><b>Peak heights.</b> Oxygen's 2p peak is taller &mdash; four electrons against nitrogen's three &mdash; because peak height is proportional to the number of electrons in the subshell. The 1s and 2s peaks are the same height in both, at two electrons each.</p><p><b>Peak positions.</b> Oxygen's 1s peak (52.6 MJ/mol) and 2s peak (3.12 MJ/mol) both sit at higher binding energy than nitrogen's (40.2 and 2.45), because oxygen has one more proton and comparable shielding, giving a larger effective nuclear charge.</p><p><b>The exception.</b> Oxygen's 2p peak (1.31) is at <em>lower</em> binding energy than nitrogen's (1.40). Oxygen's fourth 2p electron must pair in an orbital that already holds an electron, and the resulting repulsion makes it easier to remove despite the extra proton.</p>"},

 {q:"A student claims that the photoelectron spectrum of sodium should have three peaks because sodium atoms have three shells. Explain what is wrong with the reasoning and give the correct answer.",
  m:"<p>The student is counting shells, but photoelectron spectroscopy resolves <em>subshells</em>. Sodium is 1s&sup2;2s&sup2;2p&#8310;3s&sup1;, which is four occupied subshells, so its spectrum has <b>four peaks</b>, with relative heights 2 : 2 : 6 : 1.</p><p>The n = 2 shell alone produces two peaks, because 2s and 2p electrons have measurably different binding energies (6.84 and 3.67 MJ/mol). If shells were single energy levels, those electrons would appear as one peak. They don't &mdash; and that observation is the main experimental reason chemists describe electrons with subshells rather than simple Bohr shells.</p>"},

 {q:"Explain why, moving left to right across the second period, the 1s binding energy rises steadily (from 6.26 MJ/mol in Li to 84.0 MJ/mol in Ne) while the valence binding energy rises much more gradually.",
  m:"<p>Across the period, protons are added one at a time while electrons fill the n = 2 shell.</p><p>The 1s electrons lie inside the n = 2 shell, so the electrons being added do essentially nothing to shield them. Each added proton raises Z<sub>eff</sub> at the 1s level by very nearly one full unit, and the 1s binding energy climbs steeply.</p><p>Valence electrons are a different case. Each added proton pulls harder, but each added electron sits in the same shell and shields somewhat, partially canceling the increase. Electrons in the same shell shield each other poorly but not zero, so Z<sub>eff</sub> for the valence electrons rises &mdash; and with it binding energy and ionization energy &mdash; but far more slowly.</p><p class='note'><b>Connection to 1.7:</b> this is the mechanism behind the periodic trend in first ionization energy you'll meet next.</p>"}
];

let mcAns = 0, mcOk = 0;
document.getElementById("mcHost").innerHTML = MC.map((q,i) => `
  <div class="q" data-i="${i}">
    <div class="qnum">Question ${i+1}</div>
    <p class="qtext">${q.q}</p>
    <div class="choices">${q.c.map((c,j) =>
      `<button class="choice" data-j="${j}"><span class="ltr">${"ABCD"[j]}</span><span>${c}</span></button>`).join("")}</div>
    <div class="expl" hidden></div>
  </div>`).join("");

document.querySelectorAll("#mcHost .choice").forEach(btn => btn.addEventListener("click", () => {
  const q = btn.closest(".q"), i = +q.dataset.i, j = +btn.dataset.j;
  if(q.dataset.done) return;
  q.dataset.done = "1";
  mcAns++; if(j === MC[i].a) mcOk++;
  q.querySelectorAll(".choice").forEach((b,k) => {
    b.disabled = true;
    if(k === MC[i].a) b.classList.add("right");
    else if(k === j) b.classList.add("wrong");
  });
  const ex = q.querySelector(".expl");
  ex.hidden = false;
  ex.innerHTML = (j === MC[i].a ? "<b>Correct. </b>" : "<b>Not quite. </b>") + MC[i].e;
  document.getElementById("mcScore").textContent =
    `Answered ${mcAns} of ${MC.length} \u00b7 Correct ${mcOk}`;
}));

document.getElementById("frqHost").innerHTML =
  `<h3>Written response</h3>` + FRQ.map((f,i) => `
  <div class="q">
    <div class="qnum">Free response ${i+1}</div>
    <p class="qtext">${f.q}</p>
    <textarea placeholder="Write your answer here, then compare."></textarea>
    <details class="model"><summary>Show model answer</summary><div class="body">${f.m}</div></details>
  </div>`).join("");

/* ---------- data table ---------- */
(function(){
  const fmt = fmtBE;
  const cols = ORDER;
  let h = `<thead><tr><th>Element</th><th>Z</th>${cols.map(c=>`<th>${c}</th>`).join("")}</tr></thead><tbody>`;
  for(let z = 1; z <= 20; z++){
    h += `<tr><td>${SYM[z]}</td><td>${z}</td>`
      + cols.map((c,i) => `<td>${BE[z][i] !== undefined ? fmt(BE[z][i]) : "&mdash;"}</td>`).join("")
      + `</tr>`;
  }
  document.getElementById("dataTable").innerHTML = h + "</tbody>";
})();
</script>
