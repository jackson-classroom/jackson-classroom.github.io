<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AP Chemistry 1.5 &amp; 1.6 — Electron Configuration &amp; Photoelectron Spectroscopy</title>
<meta name="description" content="Interactive review of AP Chemistry topics 1.5 (atomic structure and electron configuration) and 1.6 (photoelectron spectroscopy), with practice questions.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Libre+Franklin:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============ tokens ============ */
:root{
  --paper:#eceef2;
  --card:#ffffff;
  --ink:#151d2e;
  --muted:#5b6577;
  --rule:#c9d0da;
  --grid:#dfe4eb;
  --s:#1d5fa8;          /* s subshells */
  --p:#a63d6b;          /* p subshells */
  --amber:#c98a10;      /* cursor / highlight */
  --good:#20724f;
  --bad:#a8342b;
  --mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --body:"Libre Franklin",system-ui,-apple-system,sans-serif;
  --r:3px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);font-family:var(--body);
  font-size:16px;line-height:1.6;
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:28px 28px;
}
.wrap{max-width:1000px;margin:0 auto;padding:0 20px 90px}
a{color:var(--s)}

/* ============ type ============ */
.eyebrow{font-family:var(--mono);font-size:.7rem;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
h1{font-family:var(--mono);font-weight:600;letter-spacing:-.02em;line-height:1.05;margin:.35em 0 0;font-size:clamp(1.9rem,5.5vw,3rem)}
h2{font-family:var(--mono);font-weight:600;font-size:1.15rem;letter-spacing:.01em;margin:0 0 .2em}
h3{font-family:var(--mono);font-weight:600;font-size:.82rem;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);margin:0 0 .7em}
.lede{max-width:62ch;color:var(--muted);margin:.9em 0 0}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* ============ header ============ */
header{border-bottom:2px solid var(--ink);padding:44px 0 0;margin-bottom:0}
.topbar{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap}
.hero-trace{margin:26px 0 0;border-top:1px solid var(--rule);padding-top:14px}
.hero-trace svg{width:100%;height:auto;display:block}
.hero-cap{font-family:var(--mono);font-size:.72rem;color:var(--muted);letter-spacing:.04em;margin:6px 0 22px}

/* ============ tabs ============ */
nav.tabs{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--rule);
  display:flex;gap:0;overflow-x:auto;margin-bottom:30px;scrollbar-width:none}
nav.tabs::-webkit-scrollbar{display:none}
.tab{font-family:var(--mono);font-size:.75rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  background:none;border:0;border-bottom:2px solid transparent;color:var(--muted);
  padding:15px 16px;cursor:pointer;white-space:nowrap}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--amber)}
.tab .idx{color:var(--rule);margin-right:7px}
.tab[aria-selected="true"] .idx{color:var(--amber)}

/* ============ panels & cards ============ */
.panel{display:none}
.panel.on{display:block;animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.card{background:var(--card);border:1px solid var(--rule);border-radius:var(--r);padding:20px 22px;margin-bottom:20px}
.card.flush{padding:20px 14px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:760px){.two{grid-template-columns:1fr}}

/* ============ element picker ============ */
.picker{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:5px}
@media(max-width:560px){.picker{grid-template-columns:repeat(5,minmax(0,1fr))}}
.el{background:var(--card);border:1px solid var(--rule);border-radius:var(--r);padding:7px 2px 5px;
  cursor:pointer;text-align:center;font-family:var(--mono);line-height:1.15;transition:background .12s,border-color .12s}
.el:hover{border-color:var(--ink)}
.el .z{display:block;font-size:.6rem;color:var(--muted)}
.el .sy{display:block;font-size:1rem;font-weight:600}
.el[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--card)}
.el[aria-pressed="true"] .z{color:#9fb0c9}

/* ============ config readout ============ */
.cfg{font-family:var(--mono);font-size:1.15rem;font-weight:500;letter-spacing:.01em;word-spacing:.35em;margin:0}
.cfg sup{font-size:.62em;vertical-align:super}
.sub-s{color:var(--s)}
.sub-p{color:var(--p)}
.chip{display:inline-block;font-family:var(--mono);font-size:.68rem;letter-spacing:.09em;text-transform:uppercase;
  border:1px solid var(--rule);border-radius:99px;padding:2px 9px;color:var(--muted)}
.stat{display:flex;gap:26px;flex-wrap:wrap;margin-top:14px}
.stat div{min-width:0}
.stat .k{font-family:var(--mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.stat .v{font-family:var(--mono);font-size:1.05rem;font-weight:600}

/* ============ orbital boxes ============ */
.orbrow{display:flex;align-items:center;gap:10px;margin:0 0 7px;flex-wrap:wrap}
.orblabel{font-family:var(--mono);font-size:.8rem;font-weight:600;width:2.4em}
.boxes{display:flex;gap:3px}
.box{width:30px;height:26px;border:1.5px solid var(--rule);border-radius:2px;background:var(--card);
  display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:.95rem;letter-spacing:-.12em;
  transition:border-color .15s,background .15s}
.box.lit-s{border-color:var(--s);color:var(--s)}
.box.lit-p{border-color:var(--p);color:var(--p)}
.orbrow.flash .box{background:#fdf6e3;border-color:var(--amber)}
.tag{font-family:var(--mono);font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}

/* ============ spectrum ============ */
.spec{position:relative}
.spec svg{width:100%;height:auto;display:block;overflow:visible}
.axisline{stroke:var(--ink);stroke-width:1.4}
.tickline{stroke:var(--grid);stroke-width:1}
.ticktext{font-family:var(--mono);font-size:11px;fill:var(--muted)}
.axtitle{font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:.11em;text-transform:uppercase;fill:var(--muted)}
.trace{fill:none;stroke:var(--ink);stroke-width:2;stroke-linejoin:round}
.peaklabel{font-family:var(--mono);font-size:12.5px;font-weight:600}
.peakval{font-family:var(--mono);font-size:10.5px;fill:var(--muted)}
.hit{fill:transparent;cursor:pointer}
.cursorline{stroke:var(--amber);stroke-width:1.2;stroke-dasharray:3 3}
.controls{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 14px}
.btn{font-family:var(--mono);font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
  background:var(--card);border:1px solid var(--rule);border-radius:var(--r);padding:8px 13px;cursor:pointer;color:var(--ink)}
.btn:hover{border-color:var(--ink)}
.btn[aria-pressed="true"],.btn.solid{background:var(--ink);color:var(--card);border-color:var(--ink)}
.btn.solid:hover{background:#000}
.readout{border-left:3px solid var(--amber);background:#fdfaf1;padding:11px 14px;margin-top:14px;font-size:.92rem}
.readout .hd{font-family:var(--mono);font-weight:600;font-size:.85rem;letter-spacing:.06em}
.note{font-size:.87rem;color:var(--muted);margin:12px 0 0}

/* ============ challenge ============ */
.peakinputs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0 0}
.pk{border:1px solid var(--rule);border-radius:var(--r);padding:8px 10px;background:var(--card);min-width:88px}
.pk label{display:block;font-family:var(--mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.pk input,select,input[type=number]{font-family:var(--mono);font-size:.95rem;border:1px solid var(--rule);border-radius:2px;padding:5px 6px;width:100%;background:var(--paper);color:var(--ink)}
.pk input:focus,select:focus{outline:2px solid var(--amber);outline-offset:1px}
.verdict{margin-top:14px;padding:12px 14px;border-radius:var(--r);font-size:.93rem;border-left:3px solid}
.verdict.ok{border-color:var(--good);background:#f0f7f3}
.verdict.no{border-color:var(--bad);background:#fbf1f0}
.verdict strong{font-family:var(--mono);letter-spacing:.03em}
.score{font-family:var(--mono);font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}

/* ============ Zeff slider ============ */
.slider-row{display:flex;align-items:center;gap:12px;margin:10px 0}
.slider-row label{font-family:var(--mono);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);width:11em}
input[type=range]{flex:1;accent-color:var(--s)}
.bar{height:12px;background:var(--paper);border:1px solid var(--rule);border-radius:99px;overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--s);transition:width .2s}

/* ============ questions ============ */
.q{border-top:1px solid var(--rule);padding:20px 0}
.q:first-of-type{border-top:0;padding-top:4px}
.qnum{font-family:var(--mono);font-size:.68rem;letter-spacing:.12em;color:var(--amber);font-weight:600}
.qtext{margin:.35em 0 .9em}
.choices{display:grid;gap:7px}
.choice{text-align:left;background:var(--card);border:1px solid var(--rule);border-radius:var(--r);
  padding:10px 13px;cursor:pointer;font-family:var(--body);font-size:.95rem;color:var(--ink);display:flex;gap:10px}
.choice:hover:not([disabled]){border-color:var(--ink)}
.choice .ltr{font-family:var(--mono);font-weight:600;color:var(--muted)}
.choice.picked{border-color:var(--ink)}
.choice.right{border-color:var(--good);background:#f0f7f3}
.choice.right .ltr{color:var(--good)}
.choice.wrong{border-color:var(--bad);background:#fbf1f0}
.choice.wrong .ltr{color:var(--bad)}
.expl{margin-top:11px;font-size:.9rem;border-left:3px solid var(--rule);padding-left:12px;color:var(--muted)}
.expl b{color:var(--ink)}
details.model{margin-top:10px;border:1px solid var(--rule);border-radius:var(--r);background:var(--card)}
details.model summary{font-family:var(--mono);font-size:.72rem;font-weight:600;letter-spacing:.09em;text-transform:uppercase;
  padding:10px 13px;cursor:pointer;color:var(--muted)}
details.model summary:hover{color:var(--ink)}
details.model[open] summary{border-bottom:1px solid var(--rule)}
.model .body{padding:12px 14px;font-size:.93rem}
textarea{width:100%;min-height:82px;font-family:var(--body);font-size:.95rem;border:1px solid var(--rule);
  border-radius:var(--r);padding:9px;background:var(--paper);color:var(--ink);resize:vertical}
textarea:focus{outline:2px solid var(--amber);outline-offset:1px}

table.data{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:.8rem}
table.data th,table.data td{border-bottom:1px solid var(--rule);padding:6px 8px;text-align:right}
table.data th:first-child,table.data td:first-child{text-align:left}
table.data th{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-weight:600}
.scrollx{overflow-x:auto}

footer{border-top:1px solid var(--rule);margin-top:40px;padding-top:18px;font-size:.83rem;color:var(--muted)}
:focus-visible{outline:2px solid var(--amber);outline-offset:2px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="topbar">
    <div>
      <p class="eyebrow">AP Chemistry &middot; Unit 1 &middot; Topics 1.5 + 1.6</p>
      <h1>Where the electrons<br>actually are</h1>
    </div>
    <p class="eyebrow" style="text-align:right">Mr. Jackson<br>Regis Jesuit</p>
  </div>
  <p class="lede">You already know how to write <span class="num">1s&sup2;2s&sup2;2p&#8310;</span>. What you probably haven't seen is the experiment that proves it. Photoelectron spectroscopy fires high-energy photons at atoms, measures how much energy each ejected electron needed, and hands you back a graph. Every peak is a subshell. Every peak height is an electron count. Start with the trace below &mdash; that's neon.</p>

  <div class="hero-trace">
    <svg id="hero" viewBox="0 0 900 120" role="img" aria-label="Photoelectron spectrum of neon showing three peaks"></svg>
    <p class="hero-cap">Ne &mdash; 3 peaks, heights 2 : 2 : 6. Binding energy increases to the left.</p>
  </div>
</header>

<nav class="tabs" role="tablist">
  <button class="tab" role="tab" aria-selected="true"  data-p="p1" aria-controls="p1"><span class="idx">1.5</span>Configuration lab</button>
  <button class="tab" role="tab" aria-selected="false" data-p="p2" aria-controls="p2"><span class="idx">1.6</span>Spectrometer</button>
  <button class="tab" role="tab" aria-selected="false" data-p="p3" aria-controls="p3"><span class="idx">&#9635;</span>Identify the element</button>
  <button class="tab" role="tab" aria-selected="false" data-p="p4" aria-controls="p4"><span class="idx">&#10003;</span>Practice</button>
  <button class="tab" role="tab" aria-selected="false" data-p="p5" aria-controls="p5"><span class="idx">&#8801;</span>Data table</button>
</nav>

<!-- ================= 1.5 ================= -->
<section class="panel on" id="p1" role="tabpanel">
  <div class="card">
    <h2>Build a ground-state configuration</h2>
    <p class="note" style="margin-top:2px">Pick an element. Watch the orbitals fill in Aufbau order, one electron at a time, following Hund's rule. This is review from sophomore year &mdash; the point is to get fast at it, because topic 1.6 is unreadable without it.</p>
    <div class="picker" id="pick1" style="margin-top:16px"></div>
  </div>

  <div class="two">
    <div class="card">
      <h3>Orbital diagram</h3>
      <div id="orb"></div>
      <div class="controls" style="margin:16px 0 0">
        <button class="btn" id="replay">Replay filling</button>
      </div>
    </div>
    <div class="card">
      <h3>Configuration</h3>
      <p class="cfg" id="cfgFull"></p>
      <p class="cfg" id="cfgNoble" style="font-size:.98rem;color:var(--muted);margin-top:8px"></p>
      <div class="stat">
        <div><div class="k">Element</div><div class="v" id="stName"></div></div>
        <div><div class="k">Total e&#8315;</div><div class="v num" id="stZ"></div></div>
        <div><div class="k">Valence e&#8315;</div><div class="v num" id="stVal"></div></div>
        <div><div class="k">Subshells occupied</div><div class="v num" id="stSub"></div></div>
      </div>
      <p class="note" id="cfgNote"></p>
    </div>
  </div>

  <div class="two">
    <div class="card">
      <h3>Why order matters: Coulomb's law</h3>
      <p style="margin-top:0">Every energy question in Unit 1 traces back to one relationship. The force pulling an electron toward the nucleus grows with nuclear charge and shrinks fast with distance:</p>
      <p class="cfg" style="text-align:center;margin:16px 0">F &#8733; (Z<sub style="font-size:.6em">eff</sub> &times; e) / r&sup2;</p>
      <p style="margin-bottom:0">So an electron is held tightly when it is <b>close to the nucleus</b> and when it <b>feels a large effective nuclear charge</b>. Core electrons win on both counts, which is why they are so hard to remove. Valence electrons sit farther out <em>and</em> get shielded by everything underneath them.</p>
    </div>
    <div class="card">
      <h3>Shielding calculator</h3>
      <p class="note" style="margin-top:0">Slide the inner-shell electron count and watch what the outermost electron actually feels. (Simple approximation: Z<sub>eff</sub> &asymp; Z &minus; core electrons.)</p>
      <div class="slider-row">
        <label for="zp">Protons (Z)</label>
        <input type="range" id="zp" min="1" max="20" value="11">
        <span class="v num" id="zpv" style="width:2.2em;text-align:right;font-family:var(--mono);font-weight:600">11</span>
      </div>
      <div class="slider-row">
        <label for="zs">Core e&#8315; shielding</label>
        <input type="range" id="zs" min="0" max="19" value="10">
        <span class="v num" id="zsv" style="width:2.2em;text-align:right;font-family:var(--mono);font-weight:600">10</span>
      </div>
      <div class="stat">
        <div><div class="k">Z<sub>eff</sub> felt by outer e&#8315;</div><div class="v num" id="zeff">+1</div></div>
      </div>
      <div class="bar"><i id="zbar" style="width:5%"></i></div>
      <p class="note" id="znote"></p>
    </div>
  </div>
</section>

<!-- ================= 1.6 ================= -->
<section class="panel" id="p2" role="tabpanel">
  <div class="card">
    <h2>Read a photoelectron spectrum</h2>
    <p class="note" style="margin-top:2px">Pick an element, then <b>click any peak</b>. The matching orbitals light up in the diagram below, so you can see exactly which electrons produced that signal.</p>
    <div class="picker" id="pick2" style="margin-top:16px"></div>
  </div>

  <div class="card flush">
    <div class="controls" style="padding:0 8px">
      <span class="chip" id="specTitle">Neon</span>
      <button class="btn" id="axLog" aria-pressed="true">Log axis</button>
      <button class="btn" id="axLin" aria-pressed="false">Linear axis</button>
      <button class="btn" id="lblToggle" aria-pressed="true">Labels on</button>
      <button class="btn" id="ghostBtn" aria-pressed="false">Compare with previous element</button>
    </div>
    <div class="spec"><svg id="spectrum" viewBox="0 0 780 350" role="img" aria-label="Interactive photoelectron spectrum"></svg></div>
    <div style="padding:0 8px">
      <div class="readout" id="peakRead"><span class="hd">Click a peak</span><br>The readout will tell you which subshell it is, its binding energy, and how many electrons it represents.</div>
      <p class="note" id="axNote"></p>
    </div>
  </div>

  <div class="two">
    <div class="card">
      <h3>Linked orbital diagram</h3>
      <div id="orb2"></div>
      <p class="cfg" id="cfg2" style="margin-top:14px;font-size:1rem"></p>
    </div>
    <div class="card">
      <h3>Four rules that answer almost every PES question</h3>
      <p style="margin-top:0"><b>1. One peak = one subshell.</b> Count the peaks and you know how many subshells are occupied. Never count peaks as shells &mdash; nitrogen has two shells but three peaks.</p>
      <p><b>2. Peak height &#8733; electrons in that subshell.</b> A peak three times as tall holds three times as many electrons, not electrons of higher energy. Height and position are independent.</p>
      <p><b>3. Binding energy increases to the left.</b> The 1s peak is always farthest left. Check the axis on every exam graph, because it is drawn reversed compared to almost every other graph you have seen.</p>
      <p style="margin-bottom:0"><b>4. Add up the heights to get Z.</b> For a neutral atom, total electrons = atomic number. For an ion, the total will not match the element you were told &mdash; that's the whole trick of those questions.</p>
    </div>
  </div>
</section>

<!-- ================= challenge ================= -->
<section class="panel" id="p3" role="tabpanel">
  <div class="card">
    <h2>Identify the element</h2>
    <p class="note" style="margin-top:2px">An unlabeled spectrum, straight off the instrument. Read the electron count from each peak, left to right, then name the element. This is the exact task the AP exam gives you.</p>
    <p class="score" id="chScore" style="margin:12px 0 0">Attempted 0 &middot; Correct 0</p>
  </div>

  <div class="card flush">
    <div class="spec"><svg id="chSpec" viewBox="0 0 780 330" role="img" aria-label="Unlabeled photoelectron spectrum to identify"></svg></div>
    <div style="padding:0 8px">
      <div class="peakinputs" id="chInputs"></div>
      <div class="peakinputs">
        <div class="pk" style="min-width:170px">
          <label for="chEl">The element is&hellip;</label>
          <select id="chEl"></select>
        </div>
      </div>
      <div class="controls" style="margin-top:16px">
        <button class="btn solid" id="chCheck">Check answer</button>
        <button class="btn" id="chNew">New spectrum</button>
        <button class="btn" id="chHint">Hint</button>
      </div>
      <div id="chVerdict"></div>
    </div>
  </div>
</section>

<!-- ================= practice ================= -->
<section class="panel" id="p4" role="tabpanel">
  <div class="card">
    <h2>Practice questions</h2>
    <p class="note" style="margin-top:2px">Eight multiple choice, then four written-response prompts in AP language. Written answers aren't graded here &mdash; type yours first, then open the model answer and compare. If your answer doesn't mention Coulombic attraction, distance, or shielding somewhere, it probably wouldn't earn the point.</p>
    <p class="score" id="mcScore" style="margin:12px 0 0">Answered 0 of 8 &middot; Correct 0</p>
  </div>
  <div class="card" id="mcHost"></div>
  <div class="card" id="frqHost"></div>
</section>

<!-- ================= data ================= -->
<section class="panel" id="p5" role="tabpanel">
  <div class="card">
    <h2>Binding energies, H through Ca</h2>
    <p class="note" style="margin-top:2px">Values in MJ/mol, the units the AP exam uses. Two patterns worth staring at: every value in a column grows as you go down (more protons, stronger pull), and the outermost value in each row is that element's first ionization energy.</p>
    <div class="scrollx" style="margin-top:16px"><table class="data" id="dataTable"></table></div>
    <p class="note">Look at sulfur's 3p value against phosphorus's. It goes <em>down</em> even though sulfur has an extra proton &mdash; the fourth 3p electron has to pair up in an already-occupied orbital, and electron&ndash;electron repulsion costs more than the extra proton gains. Same reason the first ionization energy of sulfur dips below phosphorus.</p>
  </div>
</section>

<footer>
  <p>Built for AP Chemistry Unit 1, topics 1.5 (Atomic Structure and Electron Configuration) and 1.6 (Photoelectron Spectroscopy). Binding energies follow the standard AP reference table; spectra are simulated from those values, so peak widths are illustrative rather than instrumental.</p>
</footer>

</div>

<script>
"use strict";
/* ============================================================
   DATA
   ============================================================ */
const ORDER = ["1s","2s","2p","3s","3p","4s"];
const CAP = {s:2,p:6};
const NOBLE = [[2,"He"],[10,"Ne"],[18,"Ar"]];

/* binding energies in MJ/mol, listed in ORDER for each element */
const BE = {
  1:[1.31], 2:[2.37],
  3:[6.26,0.52], 4:[11.5,0.90],
  5:[19.3,1.36,0.80], 6:[28.6,1.72,1.09], 7:[40.2,2.45,1.40],
  8:[52.6,3.12,1.31], 9:[67.4,3.88,1.68], 10:[84.0,4.68,2.08],
  11:[104,6.84,3.67,0.50], 12:[126,9.07,5.31,0.74],
  13:[151,12.1,7.79,1.09,0.58], 14:[178,15.1,10.3,1.46,0.79],
  15:[208,18.7,13.5,1.95,1.06], 16:[239,22.7,16.5,2.05,1.00],
  17:[273,26.8,20.2,2.44,1.25], 18:[309,31.5,24.1,2.82,1.52],
  19:[347,37.1,29.1,3.93,2.38,0.42], 20:[390,42.7,34.0,4.65,2.90,0.59]
};
const NAMES = ["","Hydrogen","Helium","Lithium","Beryllium","Boron","Carbon","Nitrogen","Oxygen",
"Fluorine","Neon","Sodium","Magnesium","Aluminum","Silicon","Phosphorus","Sulfur","Chlorine",
"Argon","Potassium","Calcium"];
const SYM = ["","H","He","Li","Be","B","C","N","O","F","Ne","Na","Mg","Al","Si","P","S","Cl","Ar","K","Ca"];

/* fill Z electrons in Aufbau order -> [{sub,type,n,e,be}] */
function build(z){
  let left = z, out = [], i = 0;
  while(left > 0 && i < ORDER.length){
    const sub = ORDER[i], type = sub[1], n = +sub[0];
    const e = Math.min(left, CAP[type]);
    out.push({sub, type, n, e, be: BE[z][i]});
    left -= e; i++;
  }
  return out;
}
function noble(z){
  let best = null;
  for(const [nz,ns] of NOBLE) if(nz < z) best = [nz,ns];
  if(!best) return null;
  const full = build(z), core = build(best[0]).length;
  return {sym:best[1], rest: full.slice(core)};
}
const cfgHTML = (peaks) => peaks.map(p =>
  `<span class="sub-${p.type}">${p.sub}<sup>${p.e}</sup></span>`).join(" ");

/* ============================================================
   SPECTRUM RENDERING
   ============================================================ */
const LOG_DOMAIN = [0.30, 430];
const SIG = 5.2;                 // peak half-width in px
const YMAX = 6.7;                // electrons at full plot height
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function geom(vbW, vbH){
  return {l:64, r:26, t:30, b:56, w:vbW, h:vbH,
          get x0(){return this.l}, get x1(){return this.w-this.r},
          get base(){return this.h-this.b}, get ph(){return this.h-this.b-this.t}};
}
function xOf(be, g, mode, dom){
  let t;
  if(mode === "log"){
    const a = Math.log10(dom[0]), b = Math.log10(dom[1]);
    t = (Math.log10(be) - a)/(b - a);
  } else {
    t = (be - dom[0])/(dom[1] - dom[0]);
  }
  return g.x0 + (1 - t)*(g.x1 - g.x0);          // reversed: high BE on the left
}
function bell(px, peaks){                        // summed gaussian in px space
  let y = 0;
  for(const p of peaks) y += p.e*Math.exp(-((px-p.px)**2)/(2*SIG*SIG));
  return y;
}
function tracePts(peaks, g){
  const out = [];
  for(let px = g.x0; px <= g.x1; px += 1.5){
    out.push(px.toFixed(1)+","+(g.base - Math.min(bell(px,peaks),YMAX)/YMAX*g.ph).toFixed(1));
  }
  return out.join(" ");
}
function onePeakPath(p, g){
  const pts = [];
  for(let px = p.px-3.6*SIG; px <= p.px+3.6*SIG; px += 1.2){
    const y = p.e*Math.exp(-((px-p.px)**2)/(2*SIG*SIG));
    pts.push(px.toFixed(1)+","+(g.base - y/YMAX*g.ph).toFixed(1));
  }
  return `M${(p.px-3.6*SIG).toFixed(1)},${g.base} L${pts.join(" L")} L${(p.px+3.6*SIG).toFixed(1)},${g.base} Z`;
}
const LOG_TICKS = [0.3,1,3,10,30,100,300];
const fmtBE = v => v >= 100 ? v.toFixed(0) : v >= 10 ? v.toFixed(1) : v.toFixed(2);

function drawSpectrum(svg, peaks, opt){
  const o = Object.assign({mode:"log", labels:true, ghost:null, sweep:true, axes:true,
                           interactive:false, onPeak:null, selected:null, compact:false}, opt);
  const vb = svg.getAttribute("viewBox").split(" ").map(Number);
  const g = geom(vb[2], vb[3]);
  if(o.compact){ g.l = 30; g.r = 14; g.t = 8; g.b = 16; }
  const dom = o.mode === "log" ? LOG_DOMAIN : [0, Math.max(...peaks.map(p=>p.be))*1.06];
  const P = peaks.map(p => Object.assign({}, p, {px: xOf(p.be, g, o.mode, dom)}));
  let s = "";

  /* gridlines + ticks */
  if(o.axes){
    if(o.mode === "log"){
      for(const t of LOG_TICKS){
        const x = xOf(t, g, "log", dom);
        s += `<line class="tickline" x1="${x}" y1="${g.t}" x2="${x}" y2="${g.base}"/>`
           + `<text class="ticktext" x="${x}" y="${g.base+17}" text-anchor="middle">${t}</text>`;
      }
    } else {
      const step = niceStep(dom[1]);
      for(let t = 0; t <= dom[1]; t += step){
        const x = xOf(t, g, "linear", dom);
        s += `<line class="tickline" x1="${x}" y1="${g.t}" x2="${x}" y2="${g.base}"/>`
           + `<text class="ticktext" x="${x}" y="${g.base+17}" text-anchor="middle">${+t.toFixed(1)}</text>`;
      }
    }
    for(let e = 2; e <= 6; e += 2){
      const y = g.base - e/YMAX*g.ph;
      s += `<line class="tickline" x1="${g.x0}" y1="${y}" x2="${g.x1}" y2="${y}"/>`
         + `<text class="ticktext" x="${g.x0-8}" y="${y+4}" text-anchor="end">${e}</text>`;
    }
    s += `<line class="axisline" x1="${g.x0}" y1="${g.base}" x2="${g.x1}" y2="${g.base}"/>`
       + `<line class="axisline" x1="${g.x0}" y1="${g.t}" x2="${g.x0}" y2="${g.base}"/>`
       + `<text class="axtitle" x="${(g.x0+g.x1)/2}" y="${g.base+40}" text-anchor="middle">binding energy, MJ/mol</text>`
       + `<text class="ticktext" x="${g.x0}" y="${g.base+40}" text-anchor="start">&#9666; core</text>`
       + `<text class="ticktext" x="${g.x1}" y="${g.base+40}" text-anchor="end">valence &#9656;</text>`
       + `<text class="axtitle" x="${g.x0-46}" y="${g.t+g.ph/2}" text-anchor="middle" transform="rotate(-90 ${g.x0-46} ${g.t+g.ph/2})">electrons</text>`;
  }

  /* ghost comparison */
  if(o.ghost){
    const G = o.ghost.map(p => Object.assign({}, p, {px: xOf(p.be, g, o.mode, dom)}));
    s += `<polyline points="${tracePts(G,g)}" fill="none" stroke="var(--muted)" stroke-width="1.4"
           stroke-dasharray="4 3" opacity=".55"/>`;
  }

  /* peaks */
  s += `<g clip-path="url(#sweep-${svg.id})">`;
  for(const p of P){
    const col = p.type === "s" ? "var(--s)" : "var(--p)";
    const on = o.selected === p.sub;
    s += `<path d="${onePeakPath(p,g)}" fill="${col}" opacity="${on?.34:.16}"/>`;
  }
  s += `<polyline class="trace" points="${tracePts(P,g)}"/>`;
  s += `</g>`;

  /* labels + hit targets */
  for(const p of P){
    const apex = g.base - Math.min(bell(p.px,P),YMAX)/YMAX*g.ph;
    const col = p.type === "s" ? "var(--s)" : "var(--p)";
    if(o.labels){
      const lx = Math.min(Math.max(p.px, g.x0+18), g.x1-18);
      s += `<text class="peaklabel" x="${lx}" y="${apex-13}" text-anchor="middle" fill="${col}">${p.sub}<tspan font-size="9.5" dy="-4">${p.e}</tspan></text>`
         + `<text class="peakval" x="${lx}" y="${apex-3}" text-anchor="middle">${fmtBE(p.be)}</text>`;
    }
    if(o.selected === p.sub){
      s += `<line class="cursorline" x1="${p.px}" y1="${g.t}" x2="${p.px}" y2="${g.base}"/>`
         + `<circle cx="${p.px}" cy="${apex}" r="4" fill="var(--amber)"/>`;
    }
    if(o.interactive){
      s += `<rect class="hit" data-sub="${p.sub}" x="${p.px-14}" y="${g.t}" width="28" height="${g.ph}"/>`;
    }
  }

  const clipW = (o.sweep && !reduced) ? 0 : (g.x1 - g.x0 + 4);
  svg.innerHTML = `<defs><clipPath id="sweep-${svg.id}">
      <rect id="swr-${svg.id}" x="${g.x0-2}" y="0" width="${clipW}" height="${g.h}"/>
    </clipPath></defs>` + s;

  if(o.interactive && o.onPeak){
    svg.querySelectorAll(".hit").forEach(r =>
      r.addEventListener("click", () => o.onPeak(r.dataset.sub)));
  }
  if(o.sweep && !reduced){
    const rect = svg.querySelector("#swr-"+svg.id), full = g.x1-g.x0+4, t0 = performance.now();
    (function step(now){
      const k = Math.min((now-t0)/620, 1);
      rect.setAttribute("width", (full*(1-Math.pow(1-k,3))).toFixed(1));
      if(k < 1) requestAnimationFrame(step);
    })(t0);
  }
  return P;
}
function niceStep(max){
  const raw = max/6, mag = Math.pow(10, Math.floor(Math.log10(raw)));
  return [1,2,5,10].map(m=>m*mag).find(v=>v>=raw) || mag*10;
}

/* ============================================================
   ORBITAL DIAGRAM
   ============================================================ */
function drawOrbitals(host, peaks, opt){
  const o = Object.assign({lit:null, animate:false}, opt);
  host.innerHTML = peaks.map(p => {
    const nOrb = p.type === "s" ? 1 : 3;
    const arr = new Array(nOrb).fill(0);
    for(let i = 0; i < p.e; i++) arr[i % nOrb]++;      // Hund's rule
    const boxes = arr.map(c =>
      `<span class="box lit-${p.type}">${c===0?"":c===1?"&#8593;":"&#8593;&#8595;"}</span>`).join("");
    const unpaired = arr.filter(c => c === 1).length;
    const flash = o.lit === p.sub ? " flash" : "";
    return `<div class="orbrow${flash}" data-sub="${p.sub}">
        <span class="orblabel sub-${p.type}">${p.sub}</span>
        <span class="boxes">${boxes}</span>
        <span class="tag">${p.e} e&#8315;${unpaired?` &middot; ${unpaired} unpaired`:""}</span>
      </div>`;
  }).join("");
  if(o.animate && !reduced){
    const rows = [...host.querySelectorAll(".orbrow")];
    rows.forEach(r => r.style.opacity = 0);
    rows.forEach((r,i) => setTimeout(() => {
      r.style.transition = "opacity .3s"; r.style.opacity = 1;
    }, i*130));
  }
}

/* ============================================================
